# Same-host PostgreSQL may disable TLS only through an explicit loopback IP.
# Remote production databases must enable TLS; verify-full is recommended.
DATABASE_URL='postgresql://pki_console:replace-password@127.0.0.1:5432/pki_console?sslmode=disable'
# Bind to loopback and expose the service only through the local trusted proxy.
PKI_LISTEN_ADDRESS='127.0.0.1:8080'
PKI_DEVELOPMENT_INSECURE='false'
# 256-bit secret shared only with the Cloudflare Pages Function.
PKI_ORIGIN_SHARED_SECRET='replace-with-64-lowercase-hex-characters'
ROOT_USER_EMAIL='alice@example.com'
ROOT_USER_PASSWORD='replace-with-at-least-32-random-characters'
# Unpadded base32 encoding of at least 20 random bytes. PKI-Console uses HMAC-SHA-256, 6 digits, 30 seconds.
ROOT_USER_TOTP_SECRET='AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
CF_ACCESS_TEAM_DOMAIN='https://your-team.cloudflareaccess.com'
CF_ACCESS_AUD='replace-with-the-access-application-audience'
PKI_MASTER_KEY_ACTIVE_ID='v1'
# JSON object; each value is standard base64 encoding of exactly 32 random bytes.
PKI_MASTER_KEYS='{"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'
PUBLIC_BASE_URL='https://pki.altasci.com'
CONSOLE_BASE_URL='https://pki-console.altasci.com'
# cloudflared connects to the Go service through loopback.
TRUSTED_PROXY_CIDRS='127.0.0.1/32,::1/128'
